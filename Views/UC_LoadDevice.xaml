<UserControl x:Class="AgingTest.Views.UC_LoadDevice"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#F4F6F9"
             Unloaded="UserControl_Unloaded">
    <UserControl.Resources>
        <!-- GroupBox样式：重写模板实现圆角 -->
        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#D0D7E3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.RowSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                            </Border>
                            <ContentPresenter Grid.Row="0" Margin="8,4,0,4" ContentSource="Header">
                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold" Foreground="#1F2937"/>
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>
                            <ContentPresenter Grid.Row="1" Margin="8" ContentSource="Content"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 蓝色主按钮 重写模板实现圆角 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2F6FED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 橙色警告按钮 -->
        <Style x:Key="WarningButton" TargetType="Button">
            <Setter Property="Background" Value="#F27022"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 灰色按钮 -->
        <Style x:Key="GrayButton" TargetType="Button">
            <Setter Property="Background" Value="#868E96"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="DataTile" TargetType="Border">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Background" Value="#f8f9fa"/>
            <Setter Property="BorderBrush" Value="#cccccc"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
        <StackPanel Margin="12">
            <!-- =========设备1 GJDA-100-32 ========= -->
            <GroupBox Header="设备1 - GJDA-100-32" Style="{StaticResource GroupBoxStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TbDev1Status" Text="设备状态：未连接" Foreground="#DC3545" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="32通道实时采集(电压/电流)" Margin="0,6,0,10" FontSize="12" Foreground="#4B5563"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="串口：" Width="50" VerticalAlignment="Center" FontSize="12"/>
                        <ComboBox x:Name="cbbCom1" Width="160" Style="{StaticResource InputCombo}"/>
                        <TextBlock Text="波特率：" Width="60" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"/>
                        <ComboBox x:Name="cbbBaud1" Width="160" Style="{StaticResource InputCombo}"/>
                        <TextBlock Text="设备编号：" Width="70" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"/>
                        <TextBox x:Name="TxtDev1_SlaveAddr" Width="80" Style="{StaticResource InputTextBox}"/>
                        <Button Content="修改设备编号" Click="BtnTestAddr_Click" x:Name="BtnDev1_TestAddr" Margin="12,0,0,0" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="连接" Click="BtnDevConnect_Click" Name="BtnDev1_Connect" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="断开" Click="BtnDevDisconnect_Click" Name="BtnDev1_Disconnect" Style="{StaticResource GrayButton}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <WrapPanel x:Name="WrapDev1Data" Margin="0,4"/>
                </StackPanel>
            </GroupBox>

            <!-- =========设备2 GJDA-100-32 ========= -->
            <GroupBox Header="设备2 - GJDA-100-32" Style="{StaticResource GroupBoxStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TbDev2Status" Text="设备状态：未连接" Foreground="#DC3545" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="32通道实时采集(电压/电流)" Margin="0,6,0,10" FontSize="12" Foreground="#4B5563"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="串口：" Width="50" VerticalAlignment="Center" FontSize="12"/>
                        <ComboBox x:Name="cbbCom2" Width="160" Style="{StaticResource InputCombo}"/>
                        <TextBlock Text="波特率：" Width="60" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"/>
                        <ComboBox x:Name="cbbBaud2" Width="160" Style="{StaticResource InputCombo}"/>
                        <TextBlock Text="设备编号：" Width="70" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"/>
                        <TextBox x:Name="TxtDev2_SlaveAddr" Width="80" Style="{StaticResource InputTextBox}"/>
                        <Button Content="修改设备编号" Click="BtnTestAddr_Click" x:Name="BtnDev2_TestAddr" Margin="12,0,0,0" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="连接" Click="BtnDevConnect_Click" Name="BtnDev2_Connect" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="断开" Click="BtnDevDisconnect_Click" Name="BtnDev2_Disconnect" Style="{StaticResource GrayButton}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <WrapPanel x:Name="WrapDev2Data" Margin="0,4"/>
                </StackPanel>
            </GroupBox>

            <!-- =========设备3 GJDA-100-32 ========= -->
            <GroupBox Header="设备3 - GJDA-100-32" Style="{StaticResource GroupBoxStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TbDev3Status" Text="设备状态：未连接" Foreground="#DC3545" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="32通道实时采集(电压/电流)" Margin="0,6,0,10" FontSize="12" Foreground="#4B5563"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="串口：" Width="50" VerticalAlignment="Center" FontSize="12"/>
                        <ComboBox x:Name="cbbCom3" Width="160" Style="{StaticResource InputCombo}"/>
                        <TextBlock Text="波特率：" Width="60" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"/>
                        <ComboBox x:Name="cbbBaud3" Width="160" Style="{StaticResource InputCombo}"/>
                        <TextBlock Text="设备编号：" Width="70" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"/>
                        <TextBox x:Name="TxtDev3_SlaveAddr" Width="80" Style="{StaticResource InputTextBox}"/>
                        <Button Content="修改设备编号" Click="BtnTestAddr_Click" x:Name="BtnDev3_TestAddr" Margin="12,0,0,0" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="连接" Click="BtnDevConnect_Click" Name="BtnDev3_Connect" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="断开" Click="BtnDevDisconnect_Click" Name="BtnDev3_Disconnect" Style="{StaticResource GrayButton}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <WrapPanel x:Name="WrapDev3Data" Margin="0,4"/>
                </StackPanel>
            </GroupBox>

            <!-- =========设备4 GJDA-100-32 ========= -->
            <GroupBox Header="设备4 - GJDA-100-32" Style="{StaticResource GroupBoxStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TbDev4Status" Text="设备状态：未连接" Foreground="#DC3545" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="32通道实时采集(电压/电流)" Margin="0,6,0,10" FontSize="12" Foreground="#4B5563"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="串口：" Width="50" VerticalAlignment="Center" FontSize="12"/>
                        <ComboBox x:Name="cbbCom4" Width="160" Style="{StaticResource InputCombo}"/>
                        <TextBlock Text="波特率：" Width="60" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"/>
                        <ComboBox x:Name="cbbBaud4" Width="160" Style="{StaticResource InputCombo}"/>
                        <TextBlock Text="设备编号：" Width="70" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"/>
                        <TextBox x:Name="TxtDev4_SlaveAddr" Width="80" Style="{StaticResource InputTextBox}"/>
                        <Button Content="修改设备编号" Click="BtnTestAddr_Click" x:Name="BtnDev4_TestAddr" Margin="12,0,0,0" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="连接" Click="BtnDevConnect_Click" Name="BtnDev4_Connect" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="断开" Click="BtnDevDisconnect_Click" Name="BtnDev4_Disconnect" Style="{StaticResource GrayButton}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <WrapPanel x:Name="WrapDev4Data" Margin="0,4"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
