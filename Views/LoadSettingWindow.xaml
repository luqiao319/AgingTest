<Window x:Class="AgingTest.Views.LoadSettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="负载参数设置" Width="420" Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--负载模式-->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12" Grid.Row="0">
            <TextBlock Text="负载模式：" Width="80" VerticalAlignment="Center"/>
            <ComboBox x:Name="cbbMode" Width="220" SelectedIndex="0">
                <ComboBoxItem>CC 恒流_慢速</ComboBoxItem>
                <ComboBoxItem>CV 恒压</ComboBoxItem>
                <ComboBoxItem>CP 恒功率</ComboBoxItem>
                <ComboBoxItem>CR 恒阻</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <!--VOM点-->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12" Grid.Row="1">
            <TextBlock Text="VOM点(V)：" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="txtVom" Width="220" Text="12.0"/>
        </StackPanel>

        <!--负载值-->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12" Grid.Row="2">
            <TextBlock Text="负载值：" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="txtLoadValue" Width="220" Text="0.5"/>
        </StackPanel>

        <!--附加参数 ExtraParam 新增这一行-->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12" Grid.Row="3">
            <TextBlock Text="附加参数：" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="txtExtraParam" Width="220" Text="10" ToolTip="CC模式：延迟时间*10；CV/CP/CR：限流值(1A=10)"/>
        </StackPanel>

        <!--按钮行-->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0" Grid.Row="4">
            <Button x:Name="BtnSingleCh" Content="✅ 单通道设置" Width="140" Height="32" Margin="4" Click="BtnSingleCh_Click"/>
            <Button x:Name="BtnAllCh" Content="✅ 全通道设置" Width="140" Height="32" Margin="4" Click="BtnAllCh_Click"/>
        </StackPanel>
    </Grid>
</Window>
