<Window x:Class="AgingTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AgingTest"
        mc:Ignorable="d"
        Title="奇瑞C1068 老化柜测试上位机"
        Height="920" Width="1600"
        MinHeight="720" MinWidth="1280"
        WindowStartupLocation="CenterScreen"
        Background="#EFF2F7"
        PreviewMouseDown="Window_PreviewMouseDown">

    <Window.Resources>
        <!-- 状态配色 -->
        <SolidColorBrush x:Key="BrushIdle" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushBound" Color="#D8E7FF"/>
        <SolidColorBrush x:Key="BrushRT" Color="#FFF3D6"/>
        <SolidColorBrush x:Key="BrushAging" Color="#FFE3CC"/>
        <SolidColorBrush x:Key="BrushPass" Color="#D9F3E3"/>
        <SolidColorBrush x:Key="BrushFail" Color="#FFDFE2"/>

        <SolidColorBrush x:Key="BorderIdle" Color="#C9CFD8"/>
        <SolidColorBrush x:Key="BorderBound" Color="#2F6FED"/>
        <SolidColorBrush x:Key="BorderRT" Color="#E8A13C"/>
        <SolidColorBrush x:Key="BorderAging" Color="#ED7A2C"/>
        <SolidColorBrush x:Key="BorderPass" Color="#2FA84F"/>
        <SolidColorBrush x:Key="BorderFail" Color="#E5484D"/>

        <Style x:Key="CardText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1F3864"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- ================= 顶部标题栏 ================= -->
        <Border Grid.Row="0" Background="#1F3864">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="奇瑞C1068 老化柜测试上位机" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTitleSub" Text="  |  重庆宇隆老化柜项目" Foreground="#AFC4E8" FontSize="13" VerticalAlignment="Center" Margin="14,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Ellipse x:Name="CommDot" Width="10" Height="10" Fill="#F0A020" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TxtComm" Text="通讯未连接" Foreground="#FFD9A8" FontSize="13" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <TextBlock x:Name="TxtUser" Text="当前用户：--" Foreground="White" FontSize="13" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <Button x:Name="BtnUserManage" Content="用户管理" Height="26" Padding="10,0" FontSize="12" FontWeight="Bold"
                            Foreground="White" Background="#2F6FED" BorderThickness="0" Cursor="Hand"
                            Click="BtnUserManage_Click" Margin="0,0,10,0" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="BtnUserManage" Visibility="Collapsed"/>
                    <Button x:Name="BtnLogout" Content="退出登录" Height="26" Padding="10,0" FontSize="12" FontWeight="Bold"
                            Foreground="White" Background="#3A5580" BorderThickness="0" Cursor="Hand"
                            Click="BtnLogout_Click" Margin="0,0,14,0" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="BtnLogout"/>
                    <TextBlock x:Name="TxtClock" Text="--" Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" MinWidth="150" TextAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 主区域 ================= -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- ========== 左侧：48工位监控网格 ========== -->
            <Border Grid.Column="0" Background="White" BorderBrush="#D5DCE6" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="工位监控（6层 × 8列 = 48工位）" Style="{StaticResource PanelTitle}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Rectangle Width="14" Height="14" Fill="{StaticResource BrushBound}" Stroke="{StaticResource BorderBound}" StrokeThickness="1" VerticalAlignment="Center"/>
                            <TextBlock Text="已绑定" FontSize="11" Foreground="#666" Margin="4,0,12,0" VerticalAlignment="Center"/>
                            <Rectangle Width="14" Height="14" Fill="{StaticResource BrushRT}" Stroke="{StaticResource BorderRT}" StrokeThickness="1" VerticalAlignment="Center"/>
                            <TextBlock Text="常温测试" FontSize="11" Foreground="#666" Margin="4,0,12,0" VerticalAlignment="Center"/>
                            <Rectangle Width="14" Height="14" Fill="{StaticResource BrushAging}" Stroke="{StaticResource BorderAging}" StrokeThickness="1" VerticalAlignment="Center"/>
                            <TextBlock Text="老化测试" FontSize="11" Foreground="#666" Margin="4,0,12,0" VerticalAlignment="Center"/>
                            <Rectangle Width="14" Height="14" Fill="{StaticResource BrushPass}" Stroke="{StaticResource BorderPass}" StrokeThickness="1" VerticalAlignment="Center"/>
                            <TextBlock Text="通过" FontSize="11" Foreground="#666" Margin="4,0,12,0" VerticalAlignment="Center"/>
                            <Rectangle Width="14" Height="14" Fill="{StaticResource BrushFail}" Stroke="{StaticResource BorderFail}" StrokeThickness="1" VerticalAlignment="Center"/>
                            <TextBlock Text="NG" FontSize="11" Foreground="#666" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <ContentControl x:Name="StationGridHost" Grid.Row="1" Margin="0,6,0,0"/>
                </Grid>
            </Border>

            <!-- ========== 右侧：控制面板 ========== -->
            <Border Grid.Column="1" Background="White" BorderBrush="#D5DCE6" BorderThickness="1" CornerRadius="6" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- 测试控制 -->
                        <TextBlock Text="测试控制" Style="{StaticResource PanelTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnRT" Grid.Column="0" Content="常温测试" Height="64" Margin="0,0,6,0"
                                    FontSize="16" FontWeight="Bold" Foreground="White" Background="#2F80ED"
                                    BorderThickness="0" Click="BtnRT_Click"/>
                            <Button x:Name="BtnAging" Grid.Column="1" Content="老化测试" Height="64" Margin="0,0,6,0"
                                    FontSize="16" FontWeight="Bold" Foreground="White" Background="#ED7A2C"
                                    BorderThickness="0" Click="BtnAging_Click"/>
                            <Button x:Name="BtnStop" Grid.Column="2" Content="停止" Height="64"
                                    FontSize="16" FontWeight="Bold" Foreground="White" Background="#E5484D"
                                    BorderThickness="0" Click="BtnStop_Click"/>
                        </Grid>

                        <!-- 老化/测试参数 -->
                        <TextBlock Text="测试参数" Style="{StaticResource PanelTitle}" Margin="0,14,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="老化温度(℃)" FontSize="12" Foreground="#666"/>
                                <TextBox x:Name="TxtAgingTemp" Text="80" Height="30" FontSize="14" VerticalContentAlignment="Center" Margin="0,2,0,8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="老化时间(分钟)" FontSize="12" Foreground="#666"/>
                                <TextBox x:Name="TxtAgingMinutes" Text="120" Height="30" FontSize="14" VerticalContentAlignment="Center" Margin="0,2,0,8"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="轮询间隔(ms)" FontSize="12" Foreground="#666"/>
                                <TextBox x:Name="TxtPollingMs" Text="1000" Height="30" FontSize="14" VerticalContentAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="常温测试时长(秒)" FontSize="12" Foreground="#666"/>
                                <TextBox x:Name="TxtRTSeconds" Text="60" Height="30" FontSize="14" VerticalContentAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- 扫码绑定 -->
                        <TextBlock Text="扫码绑定（先扫工位码 → 再扫产品码）" Style="{StaticResource PanelTitle}" Margin="0,14,0,6"/>
                        <TextBox x:Name="ScanInput" Height="36" FontSize="15" VerticalContentAlignment="Center"
                                 Background="#FFFBE6" BorderBrush="#E8C766" BorderThickness="1.5"
                                 AutomationProperties.AutomationId="ScanInput"
                                 KeyDown="ScanInput_KeyDown" ToolTip="扫码枪扫描输入，回车确认"/>
                        <TextBlock x:Name="TxtScanHint" Text="请扫描工位码（如 POS1-1）" FontSize="13" Foreground="#2F6FED" FontWeight="Bold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtPendingStation" Text="" FontSize="13" Foreground="#ED7A2C" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="条码规则：工位码 = POS + 编号（如 POS1-1）；产品码规则待客户确认后补充" FontSize="11" Foreground="#999" Margin="0,4,0,0" TextWrapping="Wrap"/>

                        <!-- 扫码日志 -->
                        <TextBlock Text="扫码日志" Style="{StaticResource PanelTitle}" Margin="0,12,0,4"/>
                        <ListBox x:Name="LogList" Height="170" FontSize="12" BorderBrush="#D5DCE6" Background="#FAFBFD">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <!-- 统计 -->
                        <TextBlock Text="状态统计" Style="{StaticResource PanelTitle}" Margin="0,12,0,4"/>
                        <WrapPanel>
                            <Border Background="#EAF1FF" CornerRadius="4" Padding="10,5" Margin="0,0,8,6">
                                <TextBlock x:Name="TxtStatBound" Text="已绑定 0" FontSize="13" FontWeight="Bold" Foreground="#2F6FED"/>
                            </Border>
                            <Border Background="#FFF7E6" CornerRadius="4" Padding="10,5" Margin="0,0,8,6">
                                <TextBlock x:Name="TxtStatRT" Text="常温 0" FontSize="13" FontWeight="Bold" Foreground="#E8A13C"/>
                            </Border>
                            <Border Background="#FFF1E6" CornerRadius="4" Padding="10,5" Margin="0,0,8,6">
                                <TextBlock x:Name="TxtStatAging" Text="老化 0" FontSize="13" FontWeight="Bold" Foreground="#ED7A2C"/>
                            </Border>
                            <Border Background="#E8F8EF" CornerRadius="4" Padding="10,5" Margin="0,0,8,6">
                                <TextBlock x:Name="TxtStatPass" Text="通过 0" FontSize="13" FontWeight="Bold" Foreground="#2FA84F"/>
                            </Border>
                            <Border Background="#FDEBEC" CornerRadius="4" Padding="10,5" Margin="0,0,8,6">
                                <TextBlock x:Name="TxtStatFail" Text="NG 0" FontSize="13" FontWeight="Bold" Foreground="#E5484D"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================= 底部状态栏 ================= -->
        <Border Grid.Row="2" Background="#E3E8F0" BorderBrush="#C9D2E0" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="TxtStatus" Text="就绪" FontSize="12" Foreground="#555" VerticalAlignment="Center" Margin="12,0"/>
                <TextBlock Text="设备通讯接口预留（CAN / 485 / 电源控制）" FontSize="12" Foreground="#999" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
